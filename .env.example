MODEL_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash

# 切换OpenAI时将MODEL_PROVIDER改为openai，并填写以下密钥、模型。
# Responses支持当前模型的工具调用；仅在所选模型支持时使用chat_completions作对照。
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_API=responses
# 留空使用模型默认值；对照实验应明确指定该模型支持的推理级别。
OPENAI_REASONING_EFFORT=

# 使用本机Ollama时将MODEL_PROVIDER改为ollama；不需要密钥，模型须已用ollama pull下载。
OLLAMA_MODEL=qwen3.5:4b
OLLAMA_BASE_URL=http://localhost:11434/v1
